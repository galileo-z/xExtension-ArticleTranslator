<?php
$provider = FreshRSS_Context::$user_conf->article_translator_provider ?: 'openai';
$baseUrl = FreshRSS_Context::$user_conf->article_translator_oai_url;
$apiKey = FreshRSS_Context::$user_conf->article_translator_oai_key;
$model = FreshRSS_Context::$user_conf->article_translator_oai_model;
$prompt = FreshRSS_Context::$user_conf->article_translator_prompt;

$escape = static function (mixed $value): string {
  return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
};
?>
<form action="<?php echo _url('extension', 'configure', 'e', urlencode($this->getName())); ?>" method="post">
  <input type="hidden" name="_csrf" value="<?php echo FreshRSS_Auth::csrfToken(); ?>" />

  <label for="article_translator_provider"><?php echo _t('ArticleTranslator.config.ai_provider'); ?></label>
  <select name="article_translator_provider" id="article_translator_provider">
    <option value="openai" <?php echo ($provider === 'openai' ? 'selected' : ''); ?>>
      <?php echo _t('ArticleTranslator.config.openai'); ?>
    </option>
    <option value="ollama" <?php echo ($provider === 'ollama' ? 'selected' : ''); ?>>
      <?php echo _t('ArticleTranslator.config.ollama'); ?>
    </option>
    <option value="gemini" <?php echo ($provider === 'gemini' ? 'selected' : ''); ?>>
      <?php echo _t('ArticleTranslator.config.gemini'); ?>
    </option>
    <option value="lmstudio" <?php echo ($provider === 'lmstudio' ? 'selected' : ''); ?>>
      <?php echo _t('ArticleTranslator.config.lmstudio'); ?>
    </option>
  </select>

  <label for="article_translator_oai_url"><?php echo _t('ArticleTranslator.config.base_url'); ?></label>
  <input type="text" name="article_translator_oai_url" id="article_translator_oai_url" value="<?php echo $escape($baseUrl); ?>">

  <label for="article_translator_oai_key"><?php echo _t('ArticleTranslator.config.api_key'); ?></label>
  <input type="text" name="article_translator_oai_key" id="article_translator_oai_key" value="<?php echo $escape($apiKey); ?>">

  <label for="article_translator_oai_model"><?php echo _t('ArticleTranslator.config.model_name'); ?></label>
  <input type="text" name="article_translator_oai_model" id="article_translator_oai_model" value="<?php echo $escape($model); ?>">

  <label for="article_translator_prompt"><?php echo _t('ArticleTranslator.config.prompt'); ?></label>
  <textarea name="article_translator_prompt" id="article_translator_prompt"
    placeholder="<?php echo $escape(_t('ArticleTranslator.config.default_prompt')); ?>"><?php echo $escape($prompt); ?></textarea>

  <hr />
  <button type="submit"><?php echo _t('ArticleTranslator.config.save'); ?></button>
</form>
